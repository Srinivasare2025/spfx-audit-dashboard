{
  "compilerOptions": {
    "target": "es2020",
    "module": "node16",
    "lib": ["es2020", "dom"],
    "sourceMap": true,
    "jsx": "react",
    "moduleResolution": "node16",
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "types": ["webpack-env"],
    "outDir": "lib",
    "rootDir": "src"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "lib"
  ]
}
